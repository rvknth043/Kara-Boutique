<Window x:Class="AiUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Monitor"
        Height="560"
        Width="900"
        Background="#0F172A"
        Foreground="#E2E8F0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="AI Usage Monitor" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="  (WPF + Python UI Automation)" VerticalAlignment="Bottom" Opacity="0.8"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8">
            <DataGrid ItemsSource="{Binding Events}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      Background="#111827"
                      Foreground="#E2E8F0"
                      BorderThickness="0"
                      RowBackground="#0B1220"
                      AlternatingRowBackground="#111827">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding TimestampUtc}" Width="180"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="App" Binding="{Binding AppName}" Width="160"/>
                    <DataGridTextColumn Header="Window" Binding="{Binding WindowTitle}" Width="220"/>
                    <DataGridTextColumn Header="Focused UI" Binding="{Binding FocusedControl}" Width="220"/>
                    <DataGridCheckBoxColumn Header="Chatbox?" Binding="{Binding IsChatInputLikely}" Width="80"/>
                    <DataGridTextColumn Header="Time(s)" Binding="{Binding SessionSeconds}" Width="80"/>
                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="140" Height="34" Margin="0,0,8,0" Content="Refresh" Click="RefreshClicked"/>
            <Button Width="180" Height="34" Content="Run Python Collector" Click="RunCollectorClicked"/>
        </StackPanel>
    </Grid>
</Window>
